{
  "name": "stolla",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "check:workspace": "node scripts/check-workspace-layout.mjs",
    "predev": "npm run check:workspace",
    "dev": "npm run dev --workspace=web",
    "prebuild": "npm run check:workspace",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "clean": "node scripts/clean.mjs",
    "typecheck": "npm run typecheck --workspace=web",
    "test": "npm run test --workspace=web && node --test scripts/check-production-health.test.mjs",
    "test:web": "npm run test --workspace=web",
    "test:e2e": "npm run test:e2e --workspace=web",
    "test:e2e:ci": "npm run test:e2e:ci --workspace=web",
    "test:contracts": "cd contracts && cargo test",
    "build:contracts": "cd contracts && CARGO_TARGET_DIR=target stellar contract build",
    "smoke": "node scripts/smoke-dev-server.mjs"
  },
  "devDependencies": {
    "ts-morph": "^28.0.0"
  }
}
