# Copy to apps/web/.env.local and fill in real values for local development.
# See README.md "Configure environment variables" and "Deploy the web app"
# for what each variable does and where its value comes from.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_COMMUNITY_FACTORY_CONTRACT_ID=<community-factory-contract-id>
NEXT_PUBLIC_NFT_CONTRACT_ID=<community-nft-contract-id>
NEXT_PUBLIC_GOVERNOR_CONTRACT_ID=<governor-contract-id>
NEXT_PUBLIC_GOVERNOR_START_LEDGER=<governor-deploy-ledger>
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Server-only: never expose as NEXT_PUBLIC_*. Used by /api/ipfs/pin to pin
# uploads to Pinata; required before create/mint can pin metadata or images.
PINATA_JWT=<pinata-jwt>
# Optional: override Pinata's API base URL (defaults to https://api.pinata.cloud).
# PINATA_API_URL=https://api.pinata.cloud
